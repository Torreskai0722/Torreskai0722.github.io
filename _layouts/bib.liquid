---
---
{%- comment -%}
Compact plain-text publication entry:
  [VENUE 'YY] Title
  Authors (self in bold)
  Full venue name
  [Paper] [Code] [Website] [Bib]
Preprints (abbr Pre*, or booktitle Arxiv/Submission) get no venue tag.
{%- endcomment -%}
{%- assign is_preprint = false -%}
{%- if entry.abbr contains 'Pre' or entry.booktitle == 'Arxiv' or entry.booktitle == 'Submission' -%}
  {%- assign is_preprint = true -%}
{%- endif -%}
{%- assign yy = entry.year | slice: 2, 2 -%}
{%- if entry.type == 'article' and entry.journal -%}
  {%- assign venue = entry.journal -%}
{%- elsif entry.booktitle == 'Arxiv' -%}
  {%- assign venue = 'arXiv preprint' -%}
{%- elsif entry.booktitle == 'Submission' -%}
  {%- assign venue = 'Under submission' -%}
{%- elsif entry.booktitle -%}
  {%- assign venue = entry.booktitle -%}
{%- elsif entry.journal -%}
  {%- assign venue = entry.journal -%}
{%- elsif entry.school -%}
  {%- assign venue = entry.school -%}
{%- else -%}
  {%- assign venue = '' -%}
{%- endif -%}
<div class="row pub-row">
<div id="{{ entry.key }}" class="col-sm-10 pub-entry">
  <div class="pub-title">
    {%- unless is_preprint -%}<span class="pub-tag">[{{ entry.abbr }} '{{ yy }}]</span> {% endunless -%}
    {{ entry.title }}
  </div>
  <div class="pub-authors">
    {%- for author in entry.author_array -%}
      {%- assign author_is_self = false -%}
      {%- assign author_last_name = author.last | regex_replace: '[*∗†‡§¶‖&^]', '' -%}
      {%- assign author_last_html = author.last | regex_replace: '([*∗†‡§¶‖&^]+)', '<sup>\1</sup>' -%}
      {%- if site.scholar.last_name contains author_last_name and site.scholar.first_name contains author.first -%}
        {%- assign author_is_self = true -%}
      {%- endif -%}
      {%- assign coauthor_url = null -%}
      {%- assign clean_last_name = author_last_name | downcase | remove_accents -%}
      {%- if site.data.coauthors[clean_last_name] -%}
        {%- for coauthor in site.data.coauthors[clean_last_name] -%}
          {%- if coauthor.firstname contains author.first -%}
            {%- assign coauthor_url = coauthor.url -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
      {%- assign author_full_name = author.first | append: ' ' | append: author_last_name -%}
      {%- assign author_is_student = false -%}
      {%- if site.data.students contains author_full_name -%}
        {%- assign author_is_student = true -%}
      {%- endif -%}
      {%- if author_is_self -%}
        <strong>{{ author.first }} {{ author_last_html }}</strong>
      {%- elsif author_is_student -%}
        <u class="student">{{ author.first }} {{ author_last_html }}</u>
      {%- elsif coauthor_url -%}
        <a href="{{ coauthor_url }}">{{ author.first }} {{ author_last_html }}</a>
      {%- else -%}
        {{ author.first }} {{ author_last_html }}
      {%- endif -%}
      {%- unless forloop.last %}, {% endunless -%}
    {%- endfor -%}
  </div>
  {%- if venue != '' %}
  <div class="pub-venue">{{ venue }}{% if entry.note %} ({{ entry.note | strip }}){% endif %}</div>
  {%- endif %}
  {%- if entry.award %}
  <div class="pub-award">{{ entry.award_name | default: entry.award | strip_html | strip }}</div>
  {%- endif %}
  {%- if entry.pdf or entry.html or entry.code or entry.website or entry.slides or entry.video or entry.bibtex_show %}
  <div class="links pub-links">
    {%- if entry.pdf %}
      {%- if entry.pdf contains '://' %}[<a href="{{ entry.pdf }}" target="_blank">Paper</a>]
      {%- else %}[<a href="{{ entry.pdf | prepend: '/assets/pdf/' | relative_url }}" target="_blank">Paper</a>]{% endif %}
    {%- elsif entry.html %}[<a href="{{ entry.html }}" target="_blank">Paper</a>]{% endif %}
    {%- if entry.code %} [<a href="{{ entry.code }}" target="_blank">Code</a>]{% endif %}
    {%- if entry.website %} [<a href="{{ entry.website }}" target="_blank">Website</a>]{% endif %}
    {%- if entry.slides %} [<a href="{{ entry.slides }}" target="_blank">Slides</a>]{% endif %}
    {%- if entry.video %} [<a href="{{ entry.video }}" target="_blank">Video</a>]{% endif %}
    {%- if entry.bibtex_show %} [<a class="bibtex" role="button">Bib</a>]{% endif %}
  </div>
  {%- endif %}
  {%- if entry.bibtex_show %}
  <div class="bibtex hidden">
    {% highlight bibtex %}
    {{- entry.bibtex | hideCustomBibtex -}}
    {% endhighlight %}
  </div>
  {%- endif %}
</div>
  <div class="col col-sm-2 pub-preview">
    {%- if site.enable_publication_thumbnails and entry.preview %}
      {%- if entry.preview contains '://' %}
        <img class="preview z-depth-1 rounded" src="{{ entry.preview }}">
      {%- else %}
        {%- assign entry_path = entry.preview | prepend: '/assets/img/publication_preview/' %}
        {% include figure.liquid loading="eager" path=entry_path sizes="1000px" class="preview z-depth-1 rounded" zoomable=true alt=entry.preview %}
      {%- endif %}
    {%- endif %}
  </div>
</div>
